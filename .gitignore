node_modules/
# 本地 pnpm store（沙箱内无全局 store 写权限时使用 --store-dir .pnpm-store）
.pnpm-store/
# meow-memory 本地记忆库
.dsh-meow/
# 本机 profile 清单备份（接入/回退用，含机器路径，不入库）
backup-profile/
*.bak-*
_tmp-*
# npm pack 产物与工作区内 npm 缓存（沙箱内不能写全局缓存时用 --cache .npm-cache）
*.tgz
.npm-cache/
# npm 凭据（本地放 granular token 用，绝不能入库）
.npmrc
