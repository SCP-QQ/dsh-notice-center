{
  "name": "dsh-notice-center",
  "version": "1.2.0",
  "description": "DeepSeek Harness 通知中心：标签页鲸鱼状态灯（绿=跑完 / 琥珀=待处理）+ 浏览器系统通知（完成/待处理提示、45 个 opencode 音效可选、音量可配）。",
  "type": "module",
  "scripts": {
    "test": "node test/host-half.smoke.mjs && node test/client-half.smoke.mjs",
    "test:host": "node test/host-half.smoke.mjs",
    "test:client": "node test/client-half.smoke.mjs",
    "prepublishOnly": "npm test"
  },
  "main": "lib/index.mjs",
  "exports": {
    ".": {
      "default": "./lib/index.mjs"
    },
    "./client": {
      "default": "./lib/client.cjs"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.mjs",
    "lib/client.cjs",
    "cordis.patch.yml",
    "assets",
    "LICENSE",
    "README.md"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-session"
      ],
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SCP-QQ/dsh-notice-center.git"
  },
  "homepage": "https://github.com/SCP-QQ/dsh-notice-center#readme",
  "bugs": {
    "url": "https://github.com/SCP-QQ/dsh-notice-center/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "notification",
    "system-notification",
    "favicon"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-client-locale": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-session": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-settings": "^0.1.2-rc.1"
  },
  "license": "MIT"
}
